Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Scout Mini Model1
        - /TF Structure1
        - /Filtered 2D Scan1
        - /Gmapping Map1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5882353186607361
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time

Visualization Manager:
  Class: ""
  Displays:
    # ==============================
    # 你的自定义配置区域 (保持不变)
    # ==============================
    # 基础网格
    - Class: rviz/Grid
      Name: Grid
      Reference Frame: <Fixed Frame>
      Plane Cell Count: 100
      Color: 160; 160; 160
      Alpha: 0.5
      Line Style: Lines
      Value: true
      
    # 机器人模型
    - Class: rviz/RobotModel
      Name: Scout Mini Model
      Robot Description: robot_description
      Update Interval: 0
      Value: true
      Visual Enabled: true
      
    # 坐标系关系
    - Class: rviz/TF
      Name: TF Structure
      Show Names: false
      Frame Timeout: 15
      Show Axes: true
      Show Arrows: true
      Value: true
      
    # 2D 激光 (Gmapping 数据源)
    - Class: rviz/LaserScan
      Name: Filtered 2D Scan
      Topic: /scan
      Size (m): 0.05
      Color: 0; 255; 0
      Style: Flat Squares
      Value: true
      
    # SLAM 生成的栅格地图
    - Class: rviz/Map
      Name: Gmapping Map
      Topic: /map
      Color Scheme: map
      Value: true
      
    # 3D 原始点云
    - Class: rviz/PointCloud2
      Name: Raw 3D Cloud
      Topic: /velodyne_points
      Size (m): 0.02
      Color Transformer: Intensity
      Style: Points
      Value: true

  # ==============================
  # 关键修复: 这里定义了截图中的工具栏按钮
  # ==============================
  Tools:
    - Class: rviz/Interact
      Hide: false
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point

  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48

# ==============================
# 窗口布局: 强制显示工具栏
# ==============================
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  # 下面这个长字符串是标准的界面布局状态码
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Toolbars:
    tool_bar:
      auto_hide: false  # 关键设置: 禁止自动隐藏工具栏
  Views:
    collapsed: false
  Width: 1600
  X: 60
  Y: 60